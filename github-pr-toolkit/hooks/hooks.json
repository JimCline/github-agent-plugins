{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__plugin_github-pr-toolkit_github__.*|mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "CODE_CRITIC_COMPACT_CHECKPOINT_TOKENS=\"${user_config.compact_checkpoint_tokens}\" node \"${CLAUDE_PLUGIN_ROOT}/hooks/context-watch.mjs\""
          }
        ]
      }
    ]
  }
}
